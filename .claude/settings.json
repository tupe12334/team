      "Bash(make generate:*)",
      "Bash(buf generate:*)",
      "Bash(git restore:*)",
      "Bash(node:*)",
      "Bash(pnpm lint:*)",
      "Bash(npm info:*)",
      "Bash(git reset:*)",
      "Bash(git pull:*)",
      "Bash(git rm:*)",
      "Bash(pnpm build:*)",
      "Bash(find:*)",
      "Bash(npx eslint:*)",
      "Bash(xargs cat:*)",
      "Bash(cargo clippy:*)",
      "Bash(launchctl getenv:*)",
      "Bash(xargs kill:*)"
