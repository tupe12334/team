# Team daemon gRPC port (used by both daemon and client when running locally)
DAEMON_PORT=50051

# --- Docker-only settings ---
# Path to any project registered with centy on the host machine.
# Required for the centy auto-poller to discover issues marked "in queue".
# Must be set before running: docker compose up
#
# How to find a registered project path:
#   centy list projects   (pick any project_path from the output)
#
# Example:
#   CENTY_CWD=/Users/you/dev/my-project
CENTY_CWD=
