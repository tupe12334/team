# Port the daemon gRPC server listens on.
# Must match DAEMON_PORT in the root .env (or DAEMON_PORT env var when starting the daemon).
# Used by the Next.js API routes to connect to the daemon.
DAEMON_PORT=50051

# Alternative: set the full address directly (takes priority over DAEMON_PORT).
# Use this if the daemon is not on the local machine or uses a non-standard host.
# DAEMON_ADDR=[::1]:50051

# Override the host when building the address from DAEMON_PORT (default: [::1]).
# DAEMON_HOST=[::1]
